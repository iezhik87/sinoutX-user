# ═══════════════════════════════════════
# Sinout — example environment variables
# Copy to .env and fill in the values
# ═══════════════════════════════════════

# PostgreSQL
DB_USER=sinout
DB_PASSWORD=changeme_db_password

# Redis (setting a password is recommended in production)
REDIS_PASSWORD=changeme_redis_password

# Meilisearch
MEILI_KEY=changeme_meili_master_key

# Semantic agent memory: embeddings for recall by meaning.
# The MAIN path is BYOK — each user sets their own key under Settings → AI →
# Embeddings (the key belongs to their workspace; everyone pays for themselves).
# The variables below are an OPTIONAL server-side fallback: set them and THIS key
# pays for every workspace without one. Off by default — leave empty.
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
#
# By default neither is needed: the stack ships its own embedder (service
# `embeddings`), it needs no key and no internet, and nothing leaves the box.
# It is what gets used when nothing above is set.
#
# The model is multilingual and small. Bigger and better: multilingual-e5-base
# or BAAI/bge-m3 — raise EMBEDDINGS_MEM with them. Changing the model changes
# the vector size, so anything already embedded has to be reindexed.
# EMBEDDINGS_MODEL_ID=intfloat/multilingual-e5-small
# EMBEDDINGS_MEM=1g
#
# Turn the built-in embedder off entirely (semantic recall then does nothing
# unless one of the providers above is configured).
# EMBEDDINGS_LOCAL_OFF=true

# User-defined HTTP skills: allow requests to internal/local addresses, which the
# SSRF guard blocks by default. Turn this on deliberately, not by habit.
# ALLOW_CUSTOM_TOOL_INTERNAL=true

# Delivery mode: self-hosted (full power, one-time licences) | cloud
# (subscription; bash is admin-only, scripts run sandboxed).
# DEPLOYMENT_MODE=self-hosted

# Edition. Empty (the default) = the ordinary multi-user instance with an admin
# panel. `solo` = the personal self-hosted edition for ONE person: no admin panel,
# no billing/cloud/teams, and registration closes after the first user, who
# becomes the owner. The public sinoutX-user repository ships with solo.
SINOUT_EDITION=solo

# Code-execution sandbox (the executor container). Set a random token so only the
# backend can call it (the executor sits on an internal network, with no internet).
# EXECUTOR_TOKEN=<random-string-32+>

# MinIO (file storage)
MINIO_USER=sinout
MINIO_PASSWORD=changeme_minio_password

# ─── Where to keep the data (optional) ────────────────────────────────
# By default everything lives in Docker named volumes, on the system disk.
# If that disk is small, move the heavy data to another mounted one: give
# ABSOLUTE paths below. Left empty, the usual named volumes are used.
# Moving existing data is what ./migrate-storage.sh does — see its header.
# POSTGRES_DATA_DIR=/mnt/bigdisk/sinout/postgres
# MEILI_DATA_DIR=/mnt/bigdisk/sinout/meili
# MINIO_DATA_DIR=/mnt/bigdisk/sinout/minio
# UPLOADS_DIR=/mnt/bigdisk/sinout/uploads

# ─── Destinations for admin backups (optional) ────────────────────────
# A ';'-separated list of "Label=/absolute/path", offered as a choice under
# Admin → Backup and in the scheduled backup. The path must be INSIDE something
# mounted into the container. Unset, there is a single "Server" folder at
# /app/uploads/backups — the same place as UPLOADS_DIR.
#
# A separate physical disk for backups is worth it: mount it on the host, point
# BACKUP_MOUNT at it (it is passed into the container as /backups), and refer to
# /backups in BACKUP_DIRS:
# BACKUP_MOUNT=/mnt/sinout-backup
# BACKUP_DIRS=Backup disk=/backups
# (several places via ';', e.g. Backup disk=/backups;Server=/app/uploads/backups)

# JWT (at least 32 characters)
JWT_SECRET=changeme_jwt_secret_at_least_32_chars

# Encryption key for secrets at rest (AI provider keys, integration tokens).
# Strongly recommended on any cloud/multi-tenant deployment. Min 16 chars.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=changeme_encryption_key_min_16_chars

# MCP Server API key
MCP_API_KEY=changeme_mcp_api_key

# Invite code for registration (leave empty — the first user signs up without one)
# INVITE_CODE=changeme_invite_code

# CORS (the frontend origin — put your real domain here in production)
CORS_ORIGIN=https://yourdomain.com

# Application URL (used in password-reset emails)
APP_URL=https://yourdomain.com

# SMTP (password reset and notifications)
# Without these, password reset is unavailable
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SinoutX <your@gmail.com>"

# ─── NOWPayments crypto billing (optional) ────────────────────────────
# Required only to enable in-app Team license purchase via crypto.
# Get an API key + IPN secret at https://account.nowpayments.io
# IPN_SECRET signs incoming webhooks; without it, license keys are
# only generated manually by an admin via /admin/license-keys.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Team licence price (USD). It is the only licence sold, it is perpetual, and the
# payment buys a year of updates. Sold on the public /buy page via NOWPayments.
PRICE_TEAM_USD=149

# ─── Managed AI ("SinoutX" provider) ──────────────────────────────────────────
# The key WE pay for. Set it and the built-in assistant works from the first
# second of a new account — no settings screen, no BYOK. Leave it empty on a
# self-hosted instance: the provider is then not offered at all, and users
# connect their own key as before.
# Tokens spent on this key are metered into ai_usage (managed = true) and priced
# by lib/pricing.ts. Never expose this key to the frontend.
MANAGED_AI_KEY=
MANAGED_AI_MODEL=deepseek-v4-pro
MANAGED_AI_BASE_URL=https://api.deepseek.com/v1

# ─── Wallet (managed AI only) ─────────────────────────────────────────────────
# Grant credited on signup. ZERO by default: a hundred registrations at $0.50
# is a bill you pay for people who may never come back. The product free tier is
# BYOK — the user connects his own key and pays you nothing, forever.
WALLET_SIGNUP_GRANT_USD=0
# Hard stop per calendar month, per user. A tool loop can call the model
# hundreds of times unattended; nobody pays that bill willingly.
WALLET_MONTHLY_CAP_USD=20
# Below this the user is warned in the messenger he already uses.
WALLET_LOW_BALANCE_USD=0.2

# ─── Cloud subscription (DEPLOYMENT_MODE=cloud only) ──────────────────────────
# Hosting is a service; the free path is self-hosted. Nobody is billed on a
# self-hosted instance, and the instance owner/admins are never billed anywhere.
# An unpaid month freezes WRITES only — reading, search and export keep working.
PRICE_CLOUD_BASE_USD=5
# Disk is sold in 200 MB packs, not gigabytes: at $3/GB a single byte over the
# free allowance cost $3. Same rate per GB, gentler steps. A pack is charged the
# moment it is taken and every month it is held.
PRICE_STORAGE_PACK_USD=0.6
STORAGE_PACK_MB=200

# Speech recognition model for voice messages. `base` is fast and light but
# noticeably mangles Russian numbers and proper nouns ("19:06" comes out as
# "1906"). `small` is roughly 3x the CPU and ~1 GB more RAM, and much more
# accurate; `medium` better still and heavier again. The whisper service loads
# whatever is asked for, so this one variable drives both it and the backend.
WHISPER_MODEL=Systran/faster-whisper-base
