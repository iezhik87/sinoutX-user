# ═══════════════════════════════════════
# Sinout — пример переменных окружения
# Скопируй в .env и заполни значения
# ═══════════════════════════════════════

# PostgreSQL
DB_USER=sinout
DB_PASSWORD=changeme_db_password

# Redis (рекомендуется задать в продакшене)
REDIS_PASSWORD=changeme_redis_password

# Meilisearch
MEILI_KEY=changeme_meili_master_key

# Семантическая память агентов (Phase 2): эмбеддинги для recall по смыслу.
# ОСНОВНОЙ путь — BYOK: каждый задаёт свой ключ в Настройки → ИИ → Эмбеддинги
# (ключ привязан к рабочему пространству, каждый платит за себя).
# Переменные ниже — ОПЦИОНАЛЬНЫЙ серверный фолбэк: если задать, ОН платит за
# ВСЕ воркспейсы без своего ключа. По умолчанию выключено (оставьте пустым).
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# Пользовательские HTTP-навыки: разрешить запросы во внутренние/локальные адреса
# (по умолчанию SSRF-гард их блокирует). Включать только осознанно.
# ALLOW_CUSTOM_TOOL_INTERNAL=true

# Режим поставки: self-hosted (полная мощь, разовые лицензии) | cloud (подписка,
# bash недоступен не-админам, скрипты в песочнице).
# DEPLOYMENT_MODE=self-hosted

# Издание. Пусто (по умолчанию) = обычный многопользовательский инстанс с
# админкой. `solo` = персональное self-hosted-издание на ОДНОГО человека:
# нет админ-панели, нет биллинга/облака/команд, повторная регистрация закрыта
# (первый пользователь = владелец). Открытый репо sinoutX-user идёт с solo.
SINOUT_EDITION=solo
# Песочница исполнения кода (контейнер executor). Задай случайный токен, чтобы
# только backend мог дёргать executor (executor в internal-сети, без интернета).
# EXECUTOR_TOKEN=<случайная-строка-32+>

# MinIO (файловое хранилище)
MINIO_USER=sinout
MINIO_PASSWORD=changeme_minio_password

# ─── Где хранить данные (опционально) ─────────────────────────────────
# По умолчанию всё лежит в Docker named volumes (на системном диске).
# Если системный диск маленький, можно вынести тяжёлые данные на другой
# смонтированный диск: укажи АБСОЛЮТНЫЕ пути ниже. Если оставить пусто —
# используются обычные named volumes (поведение по умолчанию).
# Перенос существующих данных делает ./migrate-storage.sh (см. его шапку).
# POSTGRES_DATA_DIR=/mnt/bigdisk/sinout/postgres
# MEILI_DATA_DIR=/mnt/bigdisk/sinout/meili
# MINIO_DATA_DIR=/mnt/bigdisk/sinout/minio
# UPLOADS_DIR=/mnt/bigdisk/sinout/uploads

# ─── Места для админ-бэкапов (опционально) ────────────────────────────
# ';'-список "Метка=/абсолютный/путь" — появляется выбором в Админка→Backup
# и в автобэкапе. Путь должен быть ВНУТРИ примонтированного в контейнер места.
# Если не задано — одна папка «Сервер» = /app/uploads/backups (т.е. там же,
# где UPLOADS_DIR).
#
# Рекомендуется отдельный физический диск под бэкапы: смонтируй его на хосте,
# укажи путь в BACKUP_MOUNT (он пробросится в контейнер как /backups), и сошлись
# на /backups в BACKUP_DIRS:
# BACKUP_MOUNT=/mnt/sinout-backup
# BACKUP_DIRS=Резервный диск=/backups
# (несколько мест — через ';', например: Резервный диск=/backups;Сервер=/app/uploads/backups)

# JWT (минимум 32 символа)
JWT_SECRET=changeme_jwt_secret_at_least_32_chars

# Encryption key for secrets at rest (AI provider keys, integration tokens).
# Strongly recommended on any cloud/multi-tenant deployment. Min 16 chars.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=changeme_encryption_key_min_16_chars

# MCP Server API ключ
MCP_API_KEY=changeme_mcp_api_key

# Код приглашения для регистрации (оставь пустым — первый пользователь регистрируется без кода)
# INVITE_CODE=changeme_invite_code

# CORS (origin фронтенда — укажи реальный домен в продакшене)
CORS_ORIGIN=https://yourdomain.com

# URL приложения (используется в письмах для сброса пароля)
APP_URL=https://yourdomain.com

# SMTP (для сброса пароля и уведомлений)
# Без этих настроек функция сброса пароля недоступна
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SinoutX <your@gmail.com>"

# ─── NOWPayments crypto billing (optional) ────────────────────────────
# Required only to enable in-app Team license purchase via crypto.
# Get an API key + IPN secret at https://account.nowpayments.io
# IPN_SECRET signs incoming webhooks; without it, license keys are
# only generated manually by an admin via /admin/license-keys.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Team licence price (USD). It is the only licence sold, it is perpetual, and the
# payment buys a year of updates. Sold on the public /buy page via NOWPayments.
PRICE_TEAM_USD=149

# ─── Managed AI ("SinoutX" provider) ──────────────────────────────────────────
# The key WE pay for. Set it and the built-in assistant works from the first
# second of a new account — no settings screen, no BYOK. Leave it empty on a
# self-hosted instance: the provider is then not offered at all, and users
# connect their own key as before.
# Tokens spent on this key are metered into ai_usage (managed = true) and priced
# by lib/pricing.ts. Never expose this key to the frontend.
MANAGED_AI_KEY=
MANAGED_AI_MODEL=deepseek-v4-pro
MANAGED_AI_BASE_URL=https://api.deepseek.com/v1

# ─── Wallet (managed AI only) ─────────────────────────────────────────────────
# Grant credited on signup. ZERO by default: a hundred registrations at $0.50
# is a bill you pay for people who may never come back. The product free tier is
# BYOK — the user connects his own key and pays you nothing, forever.
WALLET_SIGNUP_GRANT_USD=0
# Hard stop per calendar month, per user. A tool loop can call the model
# hundreds of times unattended; nobody pays that bill willingly.
WALLET_MONTHLY_CAP_USD=20
# Below this the user is warned in the messenger he already uses.
WALLET_LOW_BALANCE_USD=0.2

# ─── Cloud subscription (DEPLOYMENT_MODE=cloud only) ──────────────────────────
# Hosting is a service; the free path is self-hosted. Nobody is billed on a
# self-hosted instance, and the instance owner/admins are never billed anywhere.
# An unpaid month freezes WRITES only — reading, search and export keep working.
PRICE_CLOUD_BASE_USD=5
# Disk is sold in 200 MB packs, not gigabytes: at $3/GB a single byte over the
# free allowance cost $3. Same rate per GB, gentler steps. A pack is charged the
# moment it is taken and every month it is held.
PRICE_STORAGE_PACK_USD=0.6
STORAGE_PACK_MB=200
