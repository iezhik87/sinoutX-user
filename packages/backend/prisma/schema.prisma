// ═══════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  action      String   // e.g. "member.added", "project.deleted", "ai_settings.updated"
  resourceType String? @map("resource_type") // "project" | "page" | "task" | "member" | "workspace" | "ai_settings" | "backup"
  resourceId  String?  @map("resource_id")
  resourceName String? @map("resource_name")
  meta        Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("audit_logs")
}

// One row per agent answer, not per API call: a single answer runs the model
// several times in the tool loop, and the wallet must charge for the answer.
// `cachedInputTokens` is billed separately by providers — DeepSeek charges 120x
// less for a cache hit, so ignoring it would overstate cost by an order of
// magnitude.
model AiUsage {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  userId            String?  @map("user_id")
  provider          String
  model             String
  inputTokens       Int      @default(0) @map("input_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  calls             Int      @default(0)   // model round-trips inside one answer
  // Frozen at write time: provider prices change, an old row keeps its price.
  costMicroUsd      Int      @default(0) @map("cost_micro_usd")     // provider price, 1e-6 USD
  chargedMicroUsd   Int      @default(0) @map("charged_micro_usd")  // cost x MARGIN; 0 for BYOK
  managed           Boolean  @default(false) // false = BYOK, we bill nothing
  source            String   @default("chat") // chat | telegram | viber | skill | trigger
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_usage")
}

// The CREDIT ledger: top-ups, grants, manual adjustments, refunds. Spending is
// not duplicated here — every debit already has a row in ai_usage with the
// amount charged, so the two ledgers reconcile against User.balanceMicroUsd.
//
// A top-up is written BEFORE the user pays (status = pending) and settled by the
// payment webhook. Keeping the intent in Redis, as the license flow does, loses
// the money when a slow crypto confirmation outlives the TTL.
model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  kind          String   // topup | grant | adjust | refund
  /// Signed: positive credits, negative claws back. An admin correction of -$5
  /// reads as one story; a topup next to a refund reads as a puzzle.
  amountMicroUsd Int     @map("amount_micro_usd")
  status        String   @default("completed") // pending | completed | failed
  /// NOWPayments payment_id — unique so a replayed webhook cannot credit twice.
  paymentId     String?  @unique @map("payment_id")
  orderId       String?  @unique @map("order_id")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  settledAt     DateTime? @map("settled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("wallet_transactions")
}
