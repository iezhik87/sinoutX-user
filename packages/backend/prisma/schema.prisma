model CustomField {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  fieldType   String   @map("field_type") // text | number | date | select | checkbox
  options     Json?    // for select: ["opt1","opt2"]
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

