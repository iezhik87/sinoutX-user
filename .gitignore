.mcp.json
.claude/

# OS
.DS_Store
Thumbs.db

# Docker volumes (если вдруг локально)
postgres_data/
redis_data/

# Каталоги данных в корне на сервере — bind-mount'ы из migrate-storage.sh.
# postgres/ под root, git его даже не читает («Permission denied» в status).
/postgres/
/meili/
/minio/
/uploads/

# Копии боевого .env рядом с ним же (.env.save, .env.save.1) — правило .env
# их не ловит, а внутри живые секреты.
.env.save*
.env.bak*

# deploy bookkeeping (per-server)
.last-deploy

# demo-video pipeline artifacts + downloaded tools
.tools/
scripts/demo-video/out/
scripts/demo-video/final/

# Landing media — не коммитим: одна перезаливка ролика = +5 МБ в историю навсегда.
# Файлы живут локально и раскатываются на сервер скриптом scripts/sync-landing-videos.sh
landing/videos/
